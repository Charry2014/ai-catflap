# Copy to .env and change what you need. Everything has a default.
# STREAM=http://host.docker.internal:8000/stream.mjpg
# STREAM=/app/recordings/20220913-014740_catcam.mp4   # replay a recording (mount it first)
# TRIGGER=210,180,250,280
# WEBSITE=https://catcam.example.com/
# RECORD_VIDEO=1
# RECORD_OVERLAYS=1
# MODEL_FILE=./test/cats.tflite
# TZ=Europe/Berlin
# On the Pi, so you can run plain `docker compose up -d`:
# COMPOSE_FILE=docker-compose.yml:docker-compose.pi.yml
