# Direct dependencies of the container. requirements.txt is generated from this:
#   uv pip compile docker/requirements.in --python-version 3.12 --universal -o docker/requirements.txt
ai-edge-litert               # object detection, replaces tflite-support (which stops at Python 3.9)
numpy
opencv-python-headless       # no GUI in a container
python-statemachine==2.0.0   # 2.1+ breaks the state classes
python-socketio
requests
websocket-client
